# ============================================================================
#  anchorplus.ru — редиректы зеркал на канонический адрес (Apache / Beget)
#
#  Кэширование статики и gzip на этом хостинге настроены на уровне сервера
#  Beget (nginx) — проверено по заголовкам ответа, отдельного .htaccess под них
#  нет. Поэтому здесь они намеренно не дублируются: файл добавляет только то,
#  чего не хватало, — склейку зеркал в один адрес https://anchorplus.ru/.
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # www → без www (сразу на https). Условие по хосту, петли не создаёт.
    RewriteCond %{HTTP_HOST} ^www\.anchorplus\.ru$ [NC]
    RewriteRule ^(.*)$ https://anchorplus.ru/$1 [R=301,L]

    # http → https для основного домена.
    # На Beget SSL терминируется на nginx, поэтому смотрим заголовок от прокси,
    # а не %{HTTPS} (иначе возможна циклическая переадресация). Если после
    # заливки http НЕ уходит на https — включите «Перенаправление на HTTPS»
    # в панели Beget (раздел «Домены»); эта строка тогда просто не сработает.
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
    RewriteRule ^(.*)$ https://anchorplus.ru/$1 [R=301,L]
</IfModule>
